APP_NAME=Fazenda Bela Vista
SECRET_KEY=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development
PORT=8000
DATABASE_URL_OVERRIDE=
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=fazenda_cafe
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
ADMIN_EMAIL=admin@fazenda.local
OPENAI_API_KEY=
OPENAI_RECOMMENDATION_MODEL=gpt-5-mini
OPENAI_ASSISTANT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=25
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Fazenda Bela Vista
SMTP_USE_TLS=true
TWO_FACTOR_CODE_MINUTES=10
TWO_FACTOR_MAX_ATTEMPTS=5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Opcional: no Google Cloud habilite "Maps Static API" (prévia satélite PNG) e "Maps JavaScript API" (desenho no mapa em satélite na página Fazendas). Mesma chave.
GOOGLE_MAPS_API_KEY=
# Supabase Storage — obrigatorio para o backup funcionar.
# Copie esses valores em: https://supabase.com/dashboard/project/<seu-projeto>/settings/api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Buckets que devem existir no Supabase Storage (crie-os manualmente se necessario):
SUPABASE_BUCKET_DB=backups-db
SUPABASE_BUCKET_FILES=anexos
# Asaas (assinaturas). Consulte docs/assinaturas-producao.md antes de ativar cobranças reais.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_BASE_URL=https://api-sandbox.asaas.com
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Mercado Pago: use as credenciais da aba Teste. true seleciona o sandbox.
MERCADOPAGO_SANDBOX=false
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
APP_PUBLIC_URL=https://app.sisfarm.com.br
# Contato exibido ao cliente em "Minha assinatura" (opcional)
SUPPORT_EMAIL=
# Dias de atraso tolerados antes do modo somente leitura
SUBSCRIPTION_GRACE_DAYS=10

# Mantenha false até validar a operação no sandbox. O piloto aceita IDs separados por vírgula.
ASAAS_LIVE_ENABLED=false
ASAAS_PILOT_ORGANIZATION_IDS=

# Cofre dos certificados A1 da NF-e (mínimo 32 caracteres). Gere com:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
NFE_CERT_MASTER_KEY=
# Chaves independentes (32 bytes em Base64) para o cofre central e as revisões
DIGITAL_CERTIFICATE_KEY=
DIGITAL_DOCUMENT_KEY=
# Somente homologação fora de produção, com IDs separados por vírgula
DIGITAL_SIGNING_PILOT_FARM_IDS=
# Arquivo privado com evidências do VALIDAR, conforme docs/assinatura-digital.md
DIGITAL_SIGNING_ITI_RECEIPTS=
# Hosts oficiais adicionais de LCR, OCSP e AIA, separados por vírgula
DIGITAL_VALIDATION_HOSTS=
